{
  "name": "webbit",
  "displayName": "Webbit",
  "description": "AI-powered code intelligence and architecture visualizer for VS Code using Gemini 3.5 Flash Lite",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onView:agenthub.sidebar",
    "onCommand:webbit.explain",
    "onCommand:agenthub.refresh"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenthub",
          "title": "Webbit",
          "icon": "media/agenthub.svg"
        }
      ]
    },
    "views": {
      "agenthub": [
        {
          "id": "agenthub.sidebar",
          "name": "Webbit",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agenthub.refresh",
        "title": "Webbit: Refresh Workspace Analysis"
      },
      {
        "command": "webbit.explain",
        "title": "Webbit: Explain File"
      },
      {
        "command": "webbit.setApiKey",
        "title": "Webbit: Set API Key"
      },
      {
        "command": "webbit.openFullGraph",
        "title": "Webbit: Open Full Dependency Graph"
      }
    ],
    "configuration": {
      "title": "Webbit",
      "properties": {
        "webbit.aiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google AI API Key for Gemini 3.5 Flash Lite (get one free at aistudio.google.com/apikey)",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:cache": "ts-node testCache.ts",
    "agent1": "ts-node agent1.ts",
    "agent2": "ts-node agent2.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^18.0.9",
    "tree-sitter-wasms": "0.1.11",
    "web-tree-sitter": "0.20.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
