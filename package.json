{
  "name": "codeintel",
  "displayName": "CodeIntel",
  "description": "AI-powered code intelligence for VS Code using Gemini 3.5 Flash Lite",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codeintel.explain"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeintel.explain",
        "title": "CodeIntel: Explain File"
      },
      {
        "command": "codeintel.setApiKey",
        "title": "CodeIntel: Set API Key"
      }
    ],
    "configuration": {
      "title": "CodeIntel",
      "properties": {
        "codeintel.aiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google AI API Key for Gemini 3.5 Flash Lite (get one free at aistudio.google.com/apikey)",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "agent1": "ts-node agent1.ts",
    "agent2": "ts-node agent2.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^18.0.9",
    "tree-sitter-wasms": "0.1.11",
    "web-tree-sitter": "0.20.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
