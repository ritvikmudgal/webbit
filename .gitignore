# =============================================================================
# CodeIntel / Graphwiz — .gitignore
# =============================================================================

# Environment variables & secrets (CRITICAL: never commit API keys)
.env
.env.*
!.env.example
*.env

# Dependencies
node_modules/
jspm_packages/

# TypeScript build output & cache
dist/
out/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# VS Code extension build artifacts
*.vsix
.vscode-test/

# IDE / Editor configuration
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
